# Flask/Server
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-me

# Database (OBLIGATORIA)
# El proyecto soporta unicamente PostgreSQL. Si DATABASE_URL falta, la app no
# arranca: no hay base por defecto ni fallback.
# Local:
DATABASE_URL=postgresql://usuario:password@localhost:5432/sirioarabia
# En Railway la inyecta automaticamente el plugin de Postgres del servicio.

# Cloudinary (for attachments)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Reporte diario (job `python -m backend.jobs.reporte_diario`)
# Usa SOLO estas variables: nunca las GMAIL_* del mail viejo por SMTP.
# Sin REPORTE_MAILER el modo es "archivo": escribe el .eml en disco y no
# contacta a Google. En local dejalo asi.
# REPORTE_MAILER=archivo
# REPORTE_ARCHIVO_DIR=/tmp/reportes
# Produccion (servicio cron de Railway, y el web si REPORTE_BOTON=1, como
# shared variables): REPORTE_MAILER=gmail_api y el token
# que da scripts/autorizar_gmail.py. NO commitear valores reales.
# REPORTE_GMAIL_CLIENT_ID=
# REPORTE_GMAIL_CLIENT_SECRET=
# REPORTE_GMAIL_REFRESH_TOKEN=
# Remitente y destinatario: la misma casilla general del negocio (una sola direccion).
# REPORTE_MAIL_FROM=
# REPORTE_MAIL_TO=
# REPORTE_REMITENTE_NOMBRE=Arabia Representaciones
# Aviso a admins en la web si el reporte no salio (1 = prendido).
# REPORTE_BANNER=0
# Boton "Generar reporte" en la web: 1 habilita /reporte (solo admin); requiere
# las REPORTE_GMAIL_* en el web. Apagado (default) las rutas dan 404.
# REPORTE_BOTON=0
